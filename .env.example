# Web server
PORT=3000
NODE_ENV=development
JWT_SECRET=change-this-secret-to-a-long-random-string
JWT_EXPIRES_IN=12h

# SQLite database file (relative to project root unless absolute)
DATABASE_FILE=backend/data/iot-monitor.db

# Default account is created automatically on first start
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
ADMIN_NAME=Dương Văn Hướng

# MQTT: set this to your MQTT broker for real ESP32 data; simulator is off by default
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_SENSOR=data_sensor
MQTT_TOPIC_CONTROL=device_control
MQTT_TOPIC_RESPONSE=device_response
MQTT_CLIENT_ID=iot-monitor-backend
MQTT_SIMULATOR=false
SENSOR_INTERVAL_MS=5000
COMMAND_TIMEOUT_MS=10000
DEVICE_ONLINE_TIMEOUT_MS=20000
